# Copy to .env and fill values.
# .env is auto-loaded by:
# - scripts/start-agent-recon-stack.mjs
# - scripts/glm-proxy.mjs
# - scripts/casebase-rag-proxy.mjs

GLM_API_KEY=
GLM_PROXY_PORT=3847

CASE_BASE_ROOT=F:/Aworks/2026studio/xujiahui/case-base
# case-base 仓库根；必须指向含 scripts/ 的目录，否则相对路径会错。
CASEBASE_EVENTS_CWD=F:\Aworks\2026studio\xujiahui\case-base
# 整条 shell 命令；Windows 推荐用官方脚本一键起 postgres+neo4j+SSE（见 README）。
# 若仅需 SSE、库已由 docker 拉起，可在命令中加 -SkipDb。
CASEBASE_EVENTS_CMD="powershell -ExecutionPolicy Bypass -File scripts/start_casebase_events.ps1 -BindHost 127.0.0.1 -Port 8787"

AGENT_RECON_HTTP_PORT=8080
CASEBASE_RAG_PORT=3851
WEB_RAG_PORT=3852
# 可选：RAG 代理转发 /events、/events/stream 时的上游（默认 http://127.0.0.1:8787）
# CASEBASE_EVENTS_UPSTREAM=http://127.0.0.1:8787
